# Prime Energy UK Production Environment Configuration Template
# DO NOT COMMIT REAL PRODUCTION SECRETS OR TOKENS TO SOURCE CONTROL

# Database (Turso Cloud Production Database)
DATABASE_URL=libsql://prime-energy-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# JWT Authentication & Session Secret
JWT_SECRET=your_secure_random_64_character_jwt_secret_key_here

# Production Frontend Origin (CORS Binding)
FRONTEND_URL=https://prime-energy-uk.vercel.app

# Client API Base URL (Compiled into Vite frontend bundle)
VITE_API_BASE_URL=https://prime-energy-api.onrender.com/api

# Node Environment & Server Port
NODE_ENV=production
PORT=4000
